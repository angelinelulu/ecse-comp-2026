<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox fx:id="rootPane" alignment="CENTER" spacing="24" styleClass="quiz-mode-select-root"
      maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
      prefHeight="720.0" prefWidth="1280.0"
      stylesheets="@../css/quizmodeselect.css"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.kirbken.controllers.QuizModeSelectController">

    <padding>
        <Insets top="60" right="60" bottom="60" left="60"/>
    </padding>

    <Label text="Choose Your Quiz Difficulty" styleClass="quiz-mode-select-title"/>

    <Button fx:id="basicButton" text="Basic — Arithmetic" onMouseClicked="#onBasicSelected"
            prefWidth="400" prefHeight="60"/>

    <Button fx:id="intermediateButton" text="Intermediate — Algebra &amp; Calculus" onMouseClicked="#onIntermediateSelected"
            prefWidth="400" prefHeight="60"/>

    <Button fx:id="customPdfButton" text="Custom — Upload Your Own PDF" onMouseClicked="#onCustomPdfSelected"
            prefWidth="400" prefHeight="60"/>

    <Button fx:id="backButton" text="Back" onMouseClicked="#onBack"/>

</VBox>
