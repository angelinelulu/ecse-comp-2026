<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" stylesheets="@../css/start.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kirbken.controllers.ArenaController">
   <children>
      <ImageView fitHeight="720.0" fitWidth="1280.0" preserveRatio="false">
        <image>
            <Image url="@../images/arena.png" />
        </image>
      </ImageView>

      <!-- Health bars overlay -->
      <HBox layoutX="70" layoutY="60" spacing="550" prefWidth="1200">

          <!-- Player 1 health bar -->
          <StackPane alignment="CENTER_LEFT">
              <Region fx:id="p1HealthBg" prefWidth="300" prefHeight="24" style="-fx-background-color: #333; -fx-background-radius: 4;" />
              <HBox fx:id="p1HealthSegments" spacing="3" prefWidth="300" prefHeight="24">
                  <Region fx:id="p1Seg0" prefWidth="34" prefHeight="28" style="-fx-background-color: #ff4444; -fx-background-radius: 2;" />
                  <Region fx:id="p1Seg1" prefWidth="34" prefHeight="28" style="-fx-background-color: #ff4444; -fx-background-radius: 2;" />
                  <Region fx:id="p1Seg2" prefWidth="34" prefHeight="28" style="-fx-background-color: #ff4444; -fx-background-radius: 2;" />
                  <Region fx:id="p1Seg3" prefWidth="34" prefHeight="28" style="-fx-background-color: #ff4444; -fx-background-radius: 2;" />
                  <Region fx:id="p1Seg4" prefWidth="34" prefHeight="28" style="-fx-background-color: #ff4444; -fx-background-radius: 2;" />
                  <Region fx:id="p1Seg5" prefWidth="34" prefHeight="28" style="-fx-background-color: #ff4444; -fx-background-radius: 2;" />
                  <Region fx:id="p1Seg6" prefWidth="34" prefHeight="28" style="-fx-background-color: #ff4444; -fx-background-radius: 2;" />
                  <Region fx:id="p1Seg7" prefWidth="34" prefHeight="28" style="-fx-background-color: #ff4444; -fx-background-radius: 2;" />
              </HBox>
          </StackPane>

          <!-- Player 2 health bar -->
          <StackPane alignment="CENTER_RIGHT">
              <Region fx:id="p2HealthBg" prefWidth="300" prefHeight="24" style="-fx-background-color: #333; -fx-background-radius: 4;" />
              <HBox fx:id="p2HealthSegments" spacing="3" prefWidth="300" prefHeight="24">
                  <Region fx:id="p2Seg0" prefWidth="34" prefHeight="28" style="-fx-background-color: #4488ff; -fx-background-radius: 2;" />
                  <Region fx:id="p2Seg1" prefWidth="34" prefHeight="28" style="-fx-background-color: #4488ff; -fx-background-radius: 2;" />
                  <Region fx:id="p2Seg2" prefWidth="34" prefHeight="28" style="-fx-background-color: #4488ff; -fx-background-radius: 2;" />
                  <Region fx:id="p2Seg3" prefWidth="34" prefHeight="28" style="-fx-background-color: #4488ff; -fx-background-radius: 2;" />
                  <Region fx:id="p2Seg4" prefWidth="34" prefHeight="28" style="-fx-background-color: #4488ff; -fx-background-radius: 2;" />
                  <Region fx:id="p2Seg5" prefWidth="34" prefHeight="28" style="-fx-background-color: #4488ff; -fx-background-radius: 2;" />
                  <Region fx:id="p2Seg6" prefWidth="34" prefHeight="28" style="-fx-background-color: #4488ff; -fx-background-radius: 2;" />
                  <Region fx:id="p2Seg7" prefWidth="34" prefHeight="28" style="-fx-background-color: #4488ff; -fx-background-radius: 2;" />
              </HBox>
          </StackPane>

      </HBox>
   </children>
</Pane>
