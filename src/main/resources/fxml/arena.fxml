<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.Glow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.shape.Arc?>
<?import javafx.scene.shape.Circle?>

<Pane fx:id="rootPane" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" stylesheets="@../css/arena.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kirbken.controllers.ArenaController">
   <children>
      <ImageView fitHeight="720.0" fitWidth="1280.0" preserveRatio="false">
        <image>
            <Image url="@../images/arena.png" />
        </image>
      </ImageView>

      <!-- Character sprites -->
      <ImageView fx:id="p1Sprite" fitHeight="820" fitWidth="750" preserveRatio="true" />
      <ImageView fx:id="p2Sprite" fitHeight="820" fitWidth="750" preserveRatio="true" />

      <!-- Health bars overlay -->
      <HBox layoutX="70" layoutY="60" prefWidth="1200" spacing="550">

        <!-- Player 1 health bar -->
        <StackPane alignment="CENTER_LEFT">
            <Region fx:id="p1HealthBg" prefHeight="24" prefWidth="300" style="-fx-background-color: #222; -fx-background-radius: 4; -fx-effect: innershadow(gaussian, rgba(0,0,0,0.6), 4, 0.3, 0, 1);" />
            <HBox fx:id="p1HealthSegments" prefHeight="24" prefWidth="300" spacing="3">
                <Region fx:id="p1Seg0" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #ff6b6b 0%, #ff4444 50%, #cc2222 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
                <Region fx:id="p1Seg1" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #ff6b6b 0%, #ff4444 50%, #cc2222 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
                <Region fx:id="p1Seg2" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #ff6b6b 0%, #ff4444 50%, #cc2222 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
                <Region fx:id="p1Seg3" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #ff6b6b 0%, #ff4444 50%, #cc2222 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
                <Region fx:id="p1Seg4" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #ff6b6b 0%, #ff4444 50%, #cc2222 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
                <Region fx:id="p1Seg5" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #ff6b6b 0%, #ff4444 50%, #cc2222 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
                <Region fx:id="p1Seg6" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #ff6b6b 0%, #ff4444 50%, #cc2222 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
                <Region fx:id="p1Seg7" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #ff6b6b 0%, #ff4444 50%, #cc2222 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
            </HBox>
        </StackPane>

        <!-- Player 2 health bar -->
        <StackPane alignment="CENTER_RIGHT">
            <Region fx:id="p2HealthBg" prefHeight="24" prefWidth="300" style="-fx-background-color: #222; -fx-background-radius: 4; -fx-effect: innershadow(gaussian, rgba(0,0,0,0.6), 4, 0.3, 0, 1);" />
            <HBox fx:id="p2HealthSegments" prefHeight="24" prefWidth="300" spacing="3">
                <Region fx:id="p2Seg0" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #6bb8ff 0%, #4488ff 50%, #2255cc 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
                <Region fx:id="p2Seg1" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #6bb8ff 0%, #4488ff 50%, #2255cc 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
                <Region fx:id="p2Seg2" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #6bb8ff 0%, #4488ff 50%, #2255cc 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
                <Region fx:id="p2Seg3" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #6bb8ff 0%, #4488ff 50%, #2255cc 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
                <Region fx:id="p2Seg4" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #6bb8ff 0%, #4488ff 50%, #2255cc 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
                <Region fx:id="p2Seg5" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #6bb8ff 0%, #4488ff 50%, #2255cc 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
                <Region fx:id="p2Seg6" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #6bb8ff 0%, #4488ff 50%, #2255cc 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
                <Region fx:id="p2Seg7" prefHeight="28" prefWidth="34" style="-fx-background-color: linear-gradient(to bottom, #6bb8ff 0%, #4488ff 50%, #2255cc 100%); -fx-background-radius: 2; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.5), 3, 0.2, 0, 1);" />
            </HBox>
        </StackPane>

      </HBox>

    <!-- Player labels -->
    <Label fx:id="p1Label" layoutX="70.0" layoutY="31.0" prefHeight="24.0" prefWidth="120.0" style="-fx-font-family: 'Geist Pixel'; -fx-font-size: 18px; -fx-text-fill: #ff4444; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 2, 0.6, 1, 1);" text="PLAYER 1" />

    <Label fx:id="p2Label" alignment="CENTER_RIGHT" layoutX="1093.0" layoutY="31.0" prefHeight="24.0" prefWidth="120.0" style="-fx-font-family: 'Geist Pixel'; -fx-font-size: 18px; -fx-text-fill: #4488ff; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.8), 2, 0.6, 1, 1);" text="PLAYER 2" />

    <!-- Timer Label -->
    <StackPane fx:id="timerContainer" layoutX="583.0" layoutY="8.0" prefHeight="100" prefWidth="130">
    <!-- Outer glowing ring -->
    <Circle fx:id="timerRingBackground" centerX="65" centerY="50" fill="TRANSPARENT" managed="false" radius="37" stroke="#3a2a6b" strokeWidth="6" />

    <!-- Progress ring that depletes as time runs out -->
    <Arc fx:id="timerArc" centerX="65" centerY="50" fill="TRANSPARENT" length="360" managed="false" radiusX="37" radiusY="37" startAngle="90" stroke="#00e5ff" strokeLineCap="ROUND" strokeWidth="6" type="OPEN">
        <effect>
            <Glow level="0.8" />
        </effect>
    </Arc>

    <!-- The number -->
    <Label fx:id="timerLabel" style="-fx-font-family: 'Tekken'; -fx-font-size: 23px; -fx-font-weight: bold; -fx-text-fill: white;" text="3:00">
        <effect>
            <Glow level="0.6" />
        </effect>
    </Label>
</StackPane>
      <ImageView fx:id="imgMute" fitHeight="59.0" fitWidth="61.0" layoutX="1213.0" layoutY="655.0" onMouseClicked="#onMute" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/muteOff.png" />
         </image>
      </ImageView>
   </children>
</Pane>
