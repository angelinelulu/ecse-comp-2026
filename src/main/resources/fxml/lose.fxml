<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.geometry.Point3D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kirbken.controllers.LoseController">
   <children>
      <!-- Background Image -->
      <ImageView fitHeight="720.0" fitWidth="1280.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/lose.png" />
         </image>
         <rotationAxis>
            <Point3D />
         </rotationAxis>
      </ImageView>
      
      <!-- Main Game Over Banner Text -->
      <Label fx:id="lblGameOver" alignment="CENTER" layoutX="7.0" layoutY="45.0" prefWidth="1280.0" styleClass="geist-pixel" text="Game Over : You Lost" textAlignment="CENTER" textFill="WHITE">
         <font>
            <Font size="48.0" />
         </font>
      </Label>
      
      <!-- Loss Subtitle Reason -->
      <Label fx:id="lblLossReason" alignment="CENTER" layoutY="116.0" prefWidth="1280.0" styleClass="geist-pixel" text="Defeated in battle" textAlignment="CENTER" textFill="WHITE">
         <font>
            <Font size="36.0" />
         </font>
      </Label>
      
      <!-- Defeated Character Sprite Visual -->
      <ImageView fx:id="imgLoser" fitHeight="820.0" fitWidth="750.0" layoutX="84.0" layoutY="250.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/basic_kirby/die.png" />
         </image>
      </ImageView>
      
      <!-- Styled Results & Database Statistics Box -->
      <TitledPane fx:id="paneResults" collapsible="false" layoutX="682.0" layoutY="205.0" prefHeight="314.0" prefWidth="503.0" text="RESULTS &amp; STATS">
         <styleClass>
            <String fx:value="geist-pixel" />
            <String fx:value="arcade-titled-pane" />
         </styleClass>
         <content>
            <Pane prefHeight="200.0" prefWidth="200.0" styleClass="arcade-pane-content">
               <children>
                  <Label fx:id="lblCharacterUsed" layoutX="25.0" layoutY="30.0" styleClass="arcade-stat-label" text="CHARACTER: KIRBY_BASE" textFill="WHITE">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblAccuracy" layoutX="25.0" layoutY="80.0" styleClass="arcade-stat-label" text="QUIZ ACCURACY: 40% (2/5)" textFill="WHITE">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblDamageDealt" layoutX="25.0" layoutY="130.0" styleClass="arcade-stat-label" text="DAMAGE DEALT: 320 HP" textFill="WHITE">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="lblExpEarned" layoutX="25.0" layoutY="180.0" styleClass="arcade-stat-highlight" text="XP EARNED: +10 XP" textFill="#39ff14">
                     <font>
                        <Font size="20.0" />
                     </font>
                  </Label>
               </children>
            </Pane>
         </content>
      </TitledPane>
      
      <!-- Navigation Button: Play Again -->
      <Button fx:id="btnPlayAgain" layoutX="398.0" layoutY="581.0" mnemonicParsing="false" onAction="#onPlayAgain" text="Play Again">
         <font>
            <Font size="25.0" />
         </font>
         <styleClass>
            <String fx:value="kirby-tekken-btn" />
            <String fx:value="geist-pixel" />
         </styleClass>
      </Button>
      
      <!-- Navigation Button: Return Home Menu -->
      <Button fx:id="btnHome" layoutX="782.0" layoutY="584.0" mnemonicParsing="false" onAction="#onHome" text="Home">
         <font>
            <Font size="25.0" />
         </font>
         <styleClass>
            <String fx:value="kirby-tekken-btn" />
            <String fx:value="geist-pixel" />
         </styleClass>
      </Button>
   </children>
</Pane>