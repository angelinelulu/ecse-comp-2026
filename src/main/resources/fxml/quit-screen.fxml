<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kirbken.controllers.QuitController" stylesheets="@../css/settings.css">
   <children>
      <VBox alignment="CENTER" layoutX="0.0" layoutY="0.0" prefHeight="720.0" prefWidth="1280.0" spacing="30.0">
         <children>
            <Label fx:id="lblConfirmation" text="Are you sure you want to quit?" />
            <HBox alignment="CENTER" spacing="30.0">
               <children>
                  <Button id="yes_button" fx:id="btnYes" mnemonicParsing="false" onAction="#onYesClicked" text="Yes" />
                  <Button id="no_button" fx:id="btnNo" mnemonicParsing="false" onAction="#onNoClicked" text="No" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
</Pane>